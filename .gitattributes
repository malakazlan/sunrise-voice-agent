# Files read inside Linux containers keep LF line endings on every checkout.
deploy/coturn/* text eol=lf
.github/ci-wait.sh text eol=lf
# The console's checks (Prettier) expect LF everywhere, a Windows checkout included. Its fonts
# stay binary.
console/** text eol=lf
console/**/*.woff2 binary
# The call page's fonts stay binary.
web/fonts/*.woff2 binary
