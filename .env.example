# Copy to .env and adjust. Every key here must be a Settings field.
# APP_ENV (required, no default): dev | demo | prod
APP_ENV=dev
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# DEMO_ACCESS_TOKEN: shared token the call page sends. Required unless APP_ENV=dev,
# and whenever TURN is configured. Generate with: openssl rand -hex 32
DEMO_ACCESS_TOKEN=
# MAX_CONCURRENT_CALLS: calls beyond this are refused with 503.
MAX_CONCURRENT_CALLS=3
# MAX_CALL_SECONDS: a call is ended after this many seconds.
MAX_CALL_SECONDS=600
# TURN_HOST: public host name of the coturn server, no scheme or port.
# Required unless APP_ENV=dev.
TURN_HOST=
# TURN_SHARED_SECRET: coturn static-auth-secret. Required unless APP_ENV=dev.
# Generate with: openssl rand -hex 32
TURN_SHARED_SECRET=
