# Copy to .env and adjust. Every key here must be a Settings field.
# APP_ENV (required, no default): dev | demo | prod
APP_ENV=dev
# APP_ROLE: what the process serves. all (the default: the calls, and the admin API when
# ADMIN_PASSWORD is set) | voice (the calls only; no admin sign-in may be set) | admin (the
# admin API only, and only when ADMIN_PASSWORD is set; refuses every key of the calls:
# IDENTITY_HASH_KEY, TURN_SHARED_SECRET, DEMO_ACCESS_TOKEN and the vendors' keys). Compose sets
# it for each service itself.
APP_ROLE=all
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# SIMULATED_NOW: empty for the real clock. Otherwise a fixed ISO date and time such as
# 2026-11-24T10:30:00 or 2026-11-24 15:30:00Z (no zone means clinic time, America/New_York);
# a bare number or a date alone stops startup. Only with APP_ENV=dev or demo; with prod,
# startup stops.
SIMULATED_NOW=
# Database. The same values configure the db container in Compose, which sets
# POSTGRES_HOST and POSTGRES_PORT for the app container itself.
# POSTGRES_HOST, POSTGRES_DB, POSTGRES_USER, POSTGRES_PASSWORD: required, no default.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=sunrise
POSTGRES_USER=sunrise
# Choose your own password; it also becomes the db container's superuser password.
# Outside APP_ENV=dev it must be at least 16 characters and not this placeholder.
POSTGRES_PASSWORD=change-me-to-a-long-random-value
# APP_DB_USER, APP_DB_PASSWORD (required, no default): the role the app itself connects as.
# The owner above only migrates, sets up this role and seeds, in the one-shot start-up
# service; the app container never receives POSTGRES_USER or POSTGRES_PASSWORD. The name is
# lower-case letters, digits and underscores, not the owner's and not starting with pg_. The
# password must differ from the owner's; outside APP_ENV=dev it follows the same rules as
# POSTGRES_PASSWORD and must not be this placeholder. A changed password takes effect at the
# next start.
APP_DB_USER=sunrise_app
APP_DB_PASSWORD=change-me-to-another-long-random-value
# AUDIT_HMAC_KEY (required, no default): the key of the audit log's hash chain. Choose your
# own and keep it outside the database. Outside APP_ENV=dev it must be at least 32 characters
# and not this placeholder. Changing it makes the existing log fail verification.
AUDIT_HMAC_KEY=change-me-to-a-long-random-audit-key
# IDENTITY_HASH_KEY (required, no default): the key of the keyed hashes that count failed
# identity checks across calls (verification_attempts). Choose your own, different from the
# audit key, and keep it outside the database. Outside APP_ENV=dev it must be at least 32
# characters and not this placeholder. Changing it starts every count again.
IDENTITY_HASH_KEY=change-me-to-a-long-random-identity-key
# MAX_CONCURRENT_CALLS (1 to 20, digits only): calls beyond this are refused with 503.
# coturn sizes its quotas from it.
MAX_CONCURRENT_CALLS=3
# MAX_CALL_SECONDS (1 to 3600): after this many seconds the agent says goodbye and the call
# ends; the server stops a call still running 30 seconds later.
MAX_CALL_SECONDS=600
# TURN_HOST: public host name of the coturn server, no scheme or port.
# TURN_SHARED_SECRET: coturn's shared secret: at least 32 of A-Z a-z 0-9 . _ ~ + / = -.
# Generate with: openssl rand -hex 32
# Both are required unless APP_ENV=dev, and they go together.
TURN_HOST=
TURN_SHARED_SECRET=
# DEMO_ACCESS_TOKEN: the token the call page sends. Required unless APP_ENV=dev, and
# whenever TURN is configured; at least 32 characters. Generate with: openssl rand -hex 32
DEMO_ACCESS_TOKEN=
# ADMIN_USER, ADMIN_PASSWORD: the admin's sign-in to the admin API (under /admin/api): HTTP
# Basic for scripts (read-only), or a browser session for the console. Empty password: the
# admin API is off. With a password the user is required: 1 to 32 letters and underscores,
# starting with a letter. The password must differ from every other secret here; outside
# APP_ENV=dev it needs at least 16 characters, 10 of them different.
ADMIN_USER=
ADMIN_PASSWORD=
# CONSOLE_ORIGIN: the console's origin, the one other origin the admin API answers (CORS) and
# the one a browser session is honoured from, such as https://console.example.org: a scheme,
# a lower-case host and an optional port (never :443 or :80), no path, no wildcard; http only
# when APP_ENV=dev. Empty: no other origin is answered, and the API's own stands in for it.
CONSOLE_ORIGIN=
# ANTHROPIC_API_KEY, DEEPGRAM_API_KEY: the model's and speech-to-text's API keys, from each
# vendor's console. Required unless APP_ENV=dev; in dev without them a call is refused at set-up.
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
# LLM_MODEL: the Claude model id the calls use.
LLM_MODEL=claude-haiku-5-5
# ELEVENLABS_API_KEY: speech out's API key, from the ElevenLabs console.
# ELEVENLABS_VOICE_ID: the voice the agent speaks with, from ElevenLabs' voice library (letters
# and digits). Both required unless APP_ENV=dev; no voice is chosen for you. In dev without
# them a call is refused at set-up.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# TTS_MODEL: eleven_flash_v2_5 (multilingual) or eleven_flash_v2 (English only), ElevenLabs'
# lowest-latency models on its streaming WebSocket.
TTS_MODEL=eleven_flash_v2_5
# VAD_STOP_SECONDS (0.2 to 2): the silence after which the caller's turn ends.
VAD_STOP_SECONDS=0.5
# IDLE_SECONDS (5 to 300): silence from the caller before the agent asks whether they are still
# there, and again before it says goodbye and ends the call.
IDLE_SECONDS=30
