# Copy to .env and adjust. Every key here must be a Settings field.
# APP_ENV (required, no default): dev | demo | prod
APP_ENV=dev
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# SIMULATED_NOW: empty for the real clock. Otherwise a fixed ISO date and time such as
# 2026-11-24T10:30:00 or 2026-11-24 15:30:00Z (no zone means clinic time, America/New_York);
# a bare number or a date alone stops startup. Only with APP_ENV=dev or demo; with prod,
# startup stops.
SIMULATED_NOW=
# Database. The same values configure the db container in Compose, which sets
# POSTGRES_HOST and POSTGRES_PORT for the app container itself.
# POSTGRES_HOST, POSTGRES_DB, POSTGRES_USER, POSTGRES_PASSWORD: required, no default.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=sunrise
POSTGRES_USER=sunrise
# Choose your own password; it also becomes the db container's superuser password.
# Outside APP_ENV=dev it must be at least 16 characters and not this placeholder.
POSTGRES_PASSWORD=change-me-to-a-long-random-value
# APP_DB_USER, APP_DB_PASSWORD (required, no default): the role the app itself connects as.
# The owner above only migrates, sets up this role and seeds, at container start. The name is
# lower-case letters, digits and underscores, not the owner's and not starting with pg_. The
# password must differ from the owner's; outside APP_ENV=dev it follows the same rules as
# POSTGRES_PASSWORD and must not be this placeholder. A changed password takes effect at the
# next start.
APP_DB_USER=sunrise_app
APP_DB_PASSWORD=change-me-to-another-long-random-value
# AUDIT_HMAC_KEY (required, no default): the key of the audit log's hash chain. Choose your
# own and keep it outside the database. Outside APP_ENV=dev it must be at least 32 characters
# and not this placeholder. Changing it makes the existing log fail verification.
AUDIT_HMAC_KEY=change-me-to-a-long-random-audit-key
# MAX_CONCURRENT_CALLS (1 to 20, digits only): calls beyond this are refused with 503.
# coturn sizes its quotas from it.
MAX_CONCURRENT_CALLS=3
# MAX_CALL_SECONDS (1 to 3600): a call is ended after this many seconds.
MAX_CALL_SECONDS=600
# TURN_HOST: public host name of the coturn server, no scheme or port.
# TURN_SHARED_SECRET: coturn's shared secret: at least 32 of A-Z a-z 0-9 . _ ~ + / = -.
# Generate with: openssl rand -hex 32
# Both are required unless APP_ENV=dev, and they go together.
TURN_HOST=
TURN_SHARED_SECRET=
# DEMO_ACCESS_TOKEN: the token the call page sends. Required unless APP_ENV=dev, and
# whenever TURN is configured; at least 32 characters. Generate with: openssl rand -hex 32
DEMO_ACCESS_TOKEN=
